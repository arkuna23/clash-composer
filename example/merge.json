{
  "template": "example/template.yaml",
  "configurations": [
    {
      "name": "High",
      "sources": [
        {
          "path": "example/high.yaml"
        }
      ],
      "includeDirect": true,
      "enableUrlTest": true,
      "includeGroups": [
        "Common"
      ]
    },
    {
      "name": "Common",
      "sources": [
        {
          "path": "example/common.yaml"
        }
      ],
      "includeDirect": true
    }
  ],
  "cacheDurationSeconds": 0,
  "rulesetStrategy": "url-ruleset"
}
